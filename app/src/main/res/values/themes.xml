<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BiliClient" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/bgblack</item>
        <item name="statusBarBackground">@color/pink</item>
        <item name="android:colorForeground">@color/textwhite</item>
        <item name="colorOnPrimary">@color/textwhite</item>
        <item name="colorPrimary">@color/textwhite</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowSwipeToDismiss" tools:ignore="NewApi">true</item>

        <item name="android:textViewStyle">@style/TextViewSytle</item>
        <item name="editTextStyle">@style/EditTextStyle</item>
        <item name="materialCardViewStyle">@style/CardStyle</item>
        <item name="materialButtonStyle">@style/ButtonStyle</item>
        <item name="switchStyle">@style/SwitchCompatStyle</item>
        <item name="radioButtonStyle">@style/RadioButtonStyle</item>
        <item name="recyclerViewStyle">@style/ListStyle</item>

        <item name="colorSwitchThumbNormal">@color/textwhite</item>
        <item name="colorControlActivated">@color/textwhite</item>
        <item name="colorControlNormal">@color/color_ripple</item>
        <item name="android:textColor">@color/textwhite</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="Theme.NoSwipe" parent="android:Theme.Black">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowSwipeToDismiss" tools:ignore="NewApi">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/bgblack</item>
        <item name="statusBarBackground">@color/pink</item>
        <item name="colorOnPrimary">@color/textwhite</item>
    </style>

    <style name="Theme.NoSwipe.AppCompat" parent="Theme.BiliClient">
        <item name="android:windowSwipeToDismiss" tools:ignore="NewApi">false</item>
    </style>

    <!-- v5.2.1 图片查看页专用：继承 app 主题（保留按钮/文字等控件样式），
         只关掉「侧滑退出」。
         为什么需要它：ImageViewerActivity.onCreate 里显式 setTheme 会覆盖 Manifest 上的主题，
         而 Theme.BiliClient 的 windowSwipeToDismiss=true 会把手势判给「下滑退出」，
         与 PhotoView 的双指缩放/拖动冲突。父主题必须是 Theme.BiliClient（不能用 Theme.NoSwipe，
         那个父类是 android:Theme.Black，会丢掉全部 app 控件样式）。 -->
    <style name="Theme.BiliClient.NoSwipe" parent="Theme.BiliClient">
        <item name="android:windowSwipeToDismiss" tools:ignore="NewApi">false</item>
    </style>

<!-- 主题色调覆盖层（#8）：按选择的主题色重定义激活态控件色，
     让开关/复选/单选/按钮/输入框光标/进度条等全部跟随主题色调 -->
<style name="ThemeOverlay.Accent.Default" parent="Theme.BiliClient" />

<style name="ThemeOverlay.Accent.Blue" parent="Theme.BiliClient">
    <item name="colorPrimary">#66CCFF</item>
    <item name="colorSecondary">#66CCFF</item>
    <item name="colorControlActivated">#66CCFF</item>
</style>

<style name="ThemeOverlay.Accent.BiliPink" parent="Theme.BiliClient">
    <item name="colorPrimary">#FB7299</item>
    <item name="colorSecondary">#FB7299</item>
    <item name="colorControlActivated">#FB7299</item>
</style>

<style name="ThemeOverlay.Accent.Mint" parent="Theme.BiliClient">
    <item name="colorPrimary">#4CD9A0</item>
    <item name="colorSecondary">#4CD9A0</item>
    <item name="colorControlActivated">#4CD9A0</item>
</style>

<style name="ThemeOverlay.Accent.Orange" parent="Theme.BiliClient">
    <item name="colorPrimary">#FF9A3C</item>
    <item name="colorSecondary">#FF9A3C</item>
    <item name="colorControlActivated">#FF9A3C</item>
</style>

<style name="ThemeOverlay.Accent.Purple" parent="Theme.BiliClient">
    <item name="colorPrimary">#9B7EDE</item>
    <item name="colorSecondary">#9B7EDE</item>
    <item name="colorControlActivated">#9B7EDE</item>
</style>

<style name="ThemeOverlay.Accent.White" parent="Theme.BiliClient">
    <item name="colorPrimary">#EBE0E2</item>
    <item name="colorSecondary">#EBE0E2</item>
    <item name="colorControlActivated">#EBE0E2</item>
</style>
</resources>
