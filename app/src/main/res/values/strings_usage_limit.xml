<?xml version="1.0" encoding="utf-8"?>
<!--
  v5.1.6 实验室「每日使用时长限制」文案。
  独立文件（不塞进 strings.xml）以便与前一轮改动解耦；Android 允许任意文件名的 values xml。
-->
<resources>
    <!-- v5.2.0：实验室里的两行文案（setting_lab_usage_limit_name / _desc）已随开关一起搬进
         「设置 → 时间管理」，文案改由 values/strings_time_mgmt.xml 提供，故此处删除，
         避免同一含义出现两套文案、以后改一处忘另一处。 -->

    <!-- 启动页：今日已使用时长（无论开关是否开启都会显示） -->
    <string name="usage_limit_today_used">今日已使用 %1$s</string>

    <!-- 启动页：超过建议时长时的开屏倒计时 -->
    <string name="usage_limit_countdown">已超过每日建议时长，%1$d 秒后进入</string>

    <!-- 设置页：关闭开关时的原地等待倒计时（%1$d 总秒数，%2$d 剩余秒数） -->
    <string name="usage_limit_guard_tip">需等待 %1$d 秒才能关闭（剩余 %2$d 秒）</string>
</resources>
