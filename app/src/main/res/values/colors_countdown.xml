<?xml version="1.0" encoding="utf-8"?>
<!--
  v5.2.0 倒计时独立页面颜色（countdown-page 代理独占文件，前缀 countdown_*）。
  绿 / 黄 / 红的**判定真源是 UsageColorUtil**（§4.2，usage-stats 代理提供），
  这里只留三份同名色值给 XML 的「初始态」用（运行时会被代码按用量覆盖），
  以及本页自己的底色 / 文字色 / 进度条轨道色。
  不要把这些键塞进 colors.xml —— 那是公共文件，会与别的代理冲突。
-->
<resources>
    <!-- 页面底色：与启动页一致的纯黑（大数字层要求黑底） -->
    <color name="countdown_bg">#000000</color>

    <!-- 文字 -->
    <color name="countdown_text_primary">#EBE0E2</color>
    <color name="countdown_text_secondary">#99EBE0E2</color>

    <!-- 今日用量的三档颜色：与 UsageColorUtil.GREEN / YELLOW / RED 一致（仅作 XML 初始态） -->
    <color name="countdown_used_green">#4CAF50</color>
    <color name="countdown_used_yellow">#FFC107</color>
    <color name="countdown_used_red">#F44336</color>

    <!-- 进度条未填充部分 -->
    <color name="countdown_progress_track">#33EBE0E2</color>
</resources>
