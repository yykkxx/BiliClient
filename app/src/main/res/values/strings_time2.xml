<?xml version="1.0" encoding="utf-8"?>
<!--
    时间管理 2（v5.2.1 重写）的全部界面文案，键前缀 tm2_。

    为什么所有页面文案集中在一个文件：
    这套功能有 7 个页面，文案高度重复（「今天已用」「配额」「借时间」反复出现）。
    分散到每页一个 strings 文件，必然出现「使用控制页叫『总量』、记录页叫『时长』」的口径分裂。
    集中之后，同一个概念只有一个键，改文案时也只改一处。

    与 strings_time_launcher.xml 的分工：
    启动页（LauncherActivity）那 5 条 launcher_* 由 Lead 自己维护，**不在这里重复**，
    否则同名概念会有两份文案、改一处忘一处。

    占位符约定：%1$d = 整数，%1$s = 文本，%1$s 等顺序写好后**不要调整**（编译期会校验 arity）。
-->
<resources>

    <!-- ======================================================================================
         通用 / 页面标题
         ====================================================================================== -->

    <string name="tm2_page_main">时间管理</string>
    <string name="tm2_page_control">使用控制</string>
    <string name="tm2_page_bank">时间银行</string>
    <string name="tm2_page_record">使用记录</string>
