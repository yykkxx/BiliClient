<?xml version="1.0" encoding="utf-8"?>
<!-- 「账号管理」页（v5.1.5）：两个页签 × 4 个端口 × 多账号。
     布局刻意只用 RelativeLayout / LinearLayout / TabLayout（不用 Fragment、不用约束布局），
     既配合手表小屏，也从根本上规避 lintVitalRelease 的 NotSibling 类跨层级约束问题。
     两个页签的内容是两套结构相同的控件（id 带 Rcmd / Main 后缀），靠 visibility 切换。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.settings.SettingAccountActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="账号管理"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/accountTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top"
        android:background="@color/bgblack"
        app:tabGravity="fill"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed" />

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/accountTabs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp">

            <!-- ==================== 页签 1：推荐页 API ==================== -->
            <LinearLayout
                android:id="@+id/accountRcmdGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/list_margin_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="7dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:text="推荐页走哪个端口"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/accountRcmdPortGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountRcmdPortWeb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Web"
                                android:textColor="#fff"
                                android:textSize="12sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountRcmdPortAndroid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Android手机"
                                android:textColor="#fff"
                                android:textSize="12sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountRcmdPortHd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="HD"
                                android:textColor="#fff"
                                android:textSize="12sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountRcmdPortTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="TV"
                                android:textColor="#fff"
                                android:textSize="12sp" />
                        </RadioGroup>

                        <TextView
                            android:id="@+id/accountRcmdPortDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:layout_marginTop="1dp"
                            android:alpha="0.9"
                            android:lineSpacingExtra="1dp"
                            android:text="Web：用软件本身的网页扫码登录"
                            android:textSize="11sp" />

                        <!-- v5.2.0 P0-2：手机端口签名口径开关（消除 -663「鉴权失败」）。
                             默认关闭 = 沿用历史行为（扫码用 TV 密钥、请求用 android 密钥，跨源）。
                             打开 = 扫码与请求都用 TV 密钥（同源），可消除部分严格接口的 -663。
                             切换不会丢已登录 token（身份 id 仍是 IDENTITY_PHONE，槽位键不变）。 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/acct_mgr_phone_tv_sign_title"
                                android:textSize="12sp" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/accountPhoneTvSign"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:text="@string/acct_mgr_phone_tv_sign_desc"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/list_margin_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="该端口的账号"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/accountRcmdEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.9"
                            android:text="该端口还没有登录账号，点下方按钮登录"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/accountRcmdList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accountRcmdLoginNew"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+ 登录新账号"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ==================== 页签 2：其它页面 API ==================== -->
            <LinearLayout
                android:id="@+id/accountMainGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/list_margin_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="7dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:text="推荐页以外的页面走哪个端口"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/accountMainPortGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountMainPortWeb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Web"
                                android:textColor="#fff"
                                android:textSize="12sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountMainPortAndroid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Android手机"
                                android:textColor="#fff"
                                android:textSize="12sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountMainPortHd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="HD"
                                android:textColor="#fff"
                                android:textSize="12sp" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/accountMainPortTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="TV"
                                android:textColor="#fff"
                                android:textSize="12sp" />
                        </RadioGroup>

                        <TextView
                            android:id="@+id/accountMainPortDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:layout_marginTop="1dp"
                            android:alpha="0.9"
                            android:lineSpacingExtra="1dp"
                            android:text="Web：用软件本身的网页扫码登录"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/list_margin_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="该端口的账号"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/accountMainEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.9"
                            android:text="该端口还没有登录账号，点下方按钮登录"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/accountMainList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accountMainLoginNew"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+ 登录新账号"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ==================== 底部公共：凭据总览（v5.2.1 四端统一） ====================
                 为什么单独一张卡：用户要求「所有操作登录凭据的地方都放在那里
                 （比如说导出登录凭据的时候，是四端同时导出）」。凭据的四件事
                 （看状态 / 导出 / 导入 / 续期）集中在这一张卡上，而不是散进两个页签里 ——
                 页签是「选端口」，凭据是「四端一起管」，两件事不该混在一起。
                 导出/导入的实现在 AccountCredentials（四端同时，认新旧两种格式）。 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="登录凭据（四端统一）"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- 四端登录状态：一行一端，文案由 refreshCredentialsCard() 生成 -->
                    <TextView
                        android:id="@+id/accountCredText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="web 未登录 · 手机 未登录 · HD 未登录 · TV 未登录"
                        android:textAlignment="textStart"
                        android:textSize="12sp"
                        tools:ignore="RtlCompat" />

                    <!-- 覆盖报告：当前端口能直接提供多少「需要登录的端点」。
                         这是「任意端口全功能」的可查证据，不是口号（见 ApiCatalog.coverageSummary） -->
                    <TextView
                        android:id="@+id/accountCoverageText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:ignore="RtlCompat" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accountExportCred"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="导出四端凭据"
                        android:textSize="12sp" />

                    <!-- 导入：AppCompatEditText 承载 JSON 文本。
                         用户换机时的实际流程是「旧机导出 → 复制 → 新机粘贴」，
                         所以这里必须是可粘贴的输入框，而不是"从文件选"（手表上没有文件选择器）。 -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/accountImportInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="粘贴凭据 JSON 后点下面的导入"
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:minLines="2"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accountImportCred"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="导入四端凭据（合并，不覆盖现有账号）"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accountRenewWeb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="立即续期 Web 登录"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== 底部公共：迁移统计 ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="API 迁移统计"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accountStatsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="APP 通道命中：0 次"
                        android:textAlignment="textStart"
                        android:textSize="12sp"
                        tools:ignore="RtlCompat" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accountStatsClear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="清空统计"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== 底部公共：说明 ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:alpha="0.9"
                    android:lineSpacingExtra="1dp"
                    android:text="两个页签互相独立：页签 1 只决定推荐页走哪个端口，页签 2 决定其余所有页面走哪个端口。\n每个端口下可同时登录多个账号，切换账号只换「这个端口当前用谁」，不影响其它端口。\n退出某个账号只清该账号凭据，不删收藏、历史、稍后再看等数据。"
                    android:textSize="11sp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>
</RelativeLayout>
