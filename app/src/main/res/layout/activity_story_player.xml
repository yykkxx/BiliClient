<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 视频画面（SurfaceView：与主播放器同样的渲染路径，手表上比 TextureView 可靠） -->
    <FrameLayout
        android:id="@+id/story_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/story_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 顶部：返回 + 标题 + UP主 -->
    <LinearLayout
        android:id="@+id/story_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:background="#33000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/story_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/pagename_default"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/arrow_back" />

            <TextView
                android:id="@+id/story_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/story_upname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:alpha="0.85"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 右侧按钮列 -->
    <LinearLayout
        android:id="@+id/story_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/story_btn_play"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/btn_player_pause"
            android:background="#4D000000" />

        <ImageView
            android:id="@+id/story_btn_like"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:src="@drawable/icon_like_0"
            android:background="#4D000000" />

        <ImageView
            android:id="@+id/story_btn_detail"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:src="@drawable/icon_info"
            android:background="#4D000000" />
    </LinearLayout>

    <!-- 加载中 -->
    <LinearLayout
        android:id="@+id/story_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:translationY="-28dp"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:id="@+id/story_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="加载中"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 状态/错误提示（常驻，可点击重试；不再像旧版那样 1.8 秒就消失，
         这样「黑屏到底为什么」在手表上也能看见） -->
    <TextView
        android:id="@+id/story_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:maxWidth="240dp"
        android:translationY="56dp"
        android:padding="8dp"
        android:background="#66000000"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 播放量/时长（左下角） -->
    <TextView
        android:id="@+id/story_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="14dp"
        android:alpha="0.85"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:shadowColor="#99000000"
        android:shadowRadius="2"
        android:shadowDx="1"
        android:shadowDy="1" />

    <!-- 底部短提示（切换方向提示） -->
    <TextView
        android:id="@+id/story_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:alpha="0.85"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 底部播放进度条 -->
    <ProgressBar
        android:id="@+id/story_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FB7299"
        android:background="#33FFFFFF" />
</FrameLayout>
