<?xml version="1.0" encoding="utf-8"?>
<!--
  使用时长统计页（v5.2.0 需求 2）：三个数字卡 + 7 日柱状图 + 今日页面停留排行。

  布局取向：单一纵向 LinearLayout（小屏/圆屏友好，不依赖 ConstraintLayout + Guideline，
  历史上 ConstraintLayout 的 NotSibling 让 lintVitalRelease 挂过）。整页可滚动。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.time.UsageStatsActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginVertical="3dp"
            android:lines="1"
            android:text="@string/usage_stats_page_name"
            android:textStyle="bold" />

    </RelativeLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top"
        android:paddingHorizontal="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- 三个数字卡：今日 / 近 7 天 / 近 30 天 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/stat_today_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/usage_stats_card_today"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/stat_week_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/usage_stats_card_week"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/stat_month_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/usage_stats_card_month"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 今日分档说明（绿/黄/红） -->
            <TextView
                android:id="@+id/stat_level_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:text="@string/usage_stats_level_hint"
                android:textSize="11sp" />

            <!-- 7 日柱状图 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="4dp"
                android:text="@string/usage_stats_chart_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.RobinNotBad.BiliClient.ui.widget.UsageChartView
                android:id="@+id/stat_chart"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp" />

            <!-- 今日页面停留排行 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="4dp"
                android:text="@string/usage_stats_rank_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.RobinNotBad.BiliClient.ui.widget.PageUsageBarView
                android:id="@+id/stat_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- 「停留最久」一句话结论 + 最忙那天 -->
            <TextView
                android:id="@+id/stat_top_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="4dp"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/stat_busiest_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="4dp"
                android:textSize="11sp" />

            <!-- 口径说明：倒计时等待时间不计入 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="4dp"
                android:paddingBottom="8dp"
                android:text="@string/usage_stats_note"
                android:textSize="10sp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
