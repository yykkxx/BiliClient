<?xml version="1.0" encoding="utf-8"?>
<!--
  使用控制页（小栏 1）：总开关 / 上学日配额 / 休息日说明 / 颜色说明 / 各项等待秒数 / 长按解除秒数。

  两条交互在这里就决定了整页的控件结构，所以先说明：
  1. 总开关关闭方向要 120 秒倒计时 → 需要一块「原地提示区」(tm2_control_guard_tip)，
     倒计时期间把提示写在那儿，开关被顶回「开」。这块区域平时隐藏，不占视觉。
  2. 配额调大要 120 秒倒计时 → 同理需要 tm2_control_quota_hint，可点击取消。

  为什么用 ScrollView 而不是 ConstraintLayout 整页铺：
  这一页内容多（开关 + 配额 + 三色图例 + 5 行等待值 + 长按说明），手表竖屏一屏放不下，
  必须能滚。RotaryScrollView 是本仓库既有的圆屏/表冠兼容容器。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".time.activity.UsageControlActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:lines="1"
            android:text="@string/tm2_page_control"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="16dp">

            <!-- ==================== 总开关 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tm2_control_switch_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/tm2_control_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:id="@+id/tm2_control_switch_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:textSize="11sp"
                tools:text="已开启。关闭需要等待 120 秒；打开会立即生效。" />

            <!-- 关闭总开关时的原地倒计时提示；平时 GONE。可点击 = 取消这次关闭 -->
            <TextView
                android:id="@+id/tm2_control_guard_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@color/tm2_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:textColor="@color/tm2_level_yellow"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="需等待 120 秒才能关闭（剩余 118 秒）" />

            <!-- ==================== 上学日配额 ==================== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/tm2_chart_axis" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tm2_control_quota_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tm2_control_quota_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:textSize="11sp"
                tools:text="当前 120 分钟。调大需要等待 120 秒，调小立即生效。" />

            <!-- 加减微调：比输入框省事（手表上开键盘输数字是折磨）。
                 中间数值用大字号，用户一眼看到「现在是多少分钟」。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tm2_quota_minus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tm2_control_quota_minus"
                    android:textSize="12sp"
                    app:cornerRadius="6dp" />

                <TextView
                    android:id="@+id/tm2_quota_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    tools:text="120 分钟" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tm2_quota_plus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tm2_control_quota_plus"
                    android:textSize="12sp"
                    app:cornerRadius="6dp" />

            </LinearLayout>

            <!-- 调大配额时的倒计时提示；可点击取消。平时 GONE -->
            <TextView
                android:id="@+id/tm2_control_quota_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@color/tm2_card_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:textColor="@color/tm2_level_yellow"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="调大到 150 分钟需等待 120 秒…（剩余 118 秒，点此取消）" />

            <!-- ==================== 休息日 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tm2_control_rest_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:text="@string/tm2_control_rest_desc"
                android:textSize="11sp" />

            <!-- ==================== 颜色说明 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tm2_control_level_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:text="@string/tm2_control_level_desc"
                android:textSize="11sp" />

            <!-- 三行图例：小圆点用 View + 背景色，文字色同步三档语义色。
                 用户要的是「绿 0~30 / 黄 30~60 / 红 60+」，这里连等待秒数一起写，
                 因为颜色与等待在需求里本来就是同一组分档，分开说反而让人以为是两套阈值。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@color/tm2_level_green" />

                <TextView
                    android:id="@+id/tm2_level_green_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/tm2_control_level_green"
                    android:textColor="@color/tm2_level_green"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@color/tm2_level_yellow" />

                <TextView
                    android:id="@+id/tm2_level_yellow_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/tm2_level_yellow"
                    android:textSize="12sp"
                    tools:text="30~60 分钟：黄色，等待 5 秒" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@color/tm2_level_red" />

                <TextView
                    android:id="@+id/tm2_level_red_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/tm2_level_red"
                    android:textSize="12sp"
                    tools:text="60 分钟以上：红色，等待 10 秒" />

            </LinearLayout>

            <!-- 当前处于哪一档：把「图例」与「我现在在哪」连起来 -->
            <TextView
                android:id="@+id/tm2_level_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="当前档位：绿色（30 分钟以内）" />

            <!-- ==================== 各项等待秒数 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tm2_control_wait_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:text="@string/tm2_control_wait_desc"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tm2_wait_toggle_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.9"
                android:textSize="12sp"
                tools:text="关闭「使用控制」总开关：等待 120 秒" />

            <TextView
                android:id="@+id/tm2_wait_quota_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.9"
                android:textSize="12sp"
                tools:text="调大上学日配额：等待 120 秒" />

            <TextView
                android:id="@+id/tm2_wait_mid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.9"
                android:textSize="12sp"
                tools:text="30~60 分钟时进入应用：等待 5 秒" />

            <TextView
                android:id="@+id/tm2_wait_high"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.9"
                android:textSize="12sp"
                tools:text="60 分钟以上进入应用：等待 10 秒" />

            <TextView
                android:id="@+id/tm2_wait_after"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.9"
                android:textSize="12sp"
                tools:text="每晚 21:30 之后不再倒计时等待（配额用完照样拦）" />

            <!-- ==================== 长按解除 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tm2_control_release_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tm2_release_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:textSize="11sp"
                tools:text="配额耗尽时，在拦截页长按按钮 45 秒可解除当天限制。次日自动恢复。" />

        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
