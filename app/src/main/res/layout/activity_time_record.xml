<?xml version="1.0" encoding="utf-8"?>
<!--
  使用记录页（小栏 3）：7 日 / 全部柱状图 + 今日页面停留排行 + 三个摘要数字 + 清空记录。

  页面按「先总后细」排：
  1. 顶部三个摘要（今日已用 / 区间合计 / 单日最高）—— 一行看量级；
  2. 柱状图（可切 7 天 / 全部）—— 看趋势；
  3. 页面停留排行（横向条）—— 看「时间花在哪」；
  4. 口径说明 + 清空按钮。

  为什么「7 天 / 全部」用两个 MaterialButton 而不是 TabLayout：
  只有两个互斥选项，两个按钮点一下切换最直接；TabLayout 要额外引入指示器与滑动动画，
  在手表小屏上占地方且没必要。选中态用按钮自身的 enabled/背景色区分（见 Activity 里的 applyRange）。

  柱状图高度固定 170dp：UsageBarChartView 的留白按自身高度比例算，
  wrap_content 在圆屏上容易被压矮，导致柱顶数字与轴标签重叠。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".time.activity.UsageRecordActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:lines="1"
            android:text="@string/tm2_page_record"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginVertical="3dp"
            android:layout_marginEnd="8dp" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="16dp">

            <!-- ==================== 三个摘要 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tm2_record_today_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tm2_unknown"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:alpha="0.7"
                        android:text="@string/tm2_record_summary_today"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tm2_record_range_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tm2_unknown"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tm2_record_range_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:alpha="0.7"
                        android:text="@string/tm2_record_summary_range"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tm2_record_max_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tm2_unknown"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:alpha="0.7"
                        android:text="@string/tm2_record_summary_max"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ==================== 区间切换 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tm2_record_range_7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:text="@string/tm2_record_range_7"
                    android:textSize="11sp"
                    app:cornerRadius="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tm2_record_range_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tm2_record_range_all"
                    android:textSize="11sp"
                    app:cornerRadius="6dp" />

            </LinearLayout>

            <!-- ==================== 柱状图 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tm2_record_chart_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:text="@string/tm2_record_chart_desc"
                android:textSize="10sp" />

            <com.RobinNotBad.BiliClient.time.ui.UsageBarChartView
                android:id="@+id/tm2_record_chart"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tm2_record_chart_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tm2_record_chart_none"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- ==================== 页面停留排行 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tm2_record_rank_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:text="@string/tm2_record_rank_desc"
                android:textSize="10sp" />

            <!-- 横向条形由 PageRankBarView 自绘；行高与整体高度由它自己按条目数算 -->
            <com.RobinNotBad.BiliClient.time.ui.PageRankBarView
                android:id="@+id/tm2_record_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tm2_record_rank_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tm2_record_rank_none"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- ==================== 口径说明 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.6"
                android:text="@string/tm2_record_note"
                android:textSize="10sp" />

            <!-- ==================== 清空记录 ==================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tm2_record_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tm2_record_clear"
                android:textSize="12sp"
                app:cornerRadius="6dp" />

        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
