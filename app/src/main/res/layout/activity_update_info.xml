<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/top"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <!-- pageName 必须保留 timeText 兄弟节点：BaseActivity.setRound() 的圆屏适配会取
             R.id.timeText，缺了会抛 NPE 并弹「圆屏适配执行错误」对话框。 -->
        <TextView android:id="@+id/pageName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp" android:layout_marginVertical="4dp"
            android:layout_toStartOf="@id/timeText"
            android:lines="1"
            android:text="@string/update_gitee_title" android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />
        <com.RobinNotBad.BiliClient.ui.widget.TextClock android:id="@+id/timeText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_marginEnd="8dp"
            android:layout_marginVertical="4dp" />
    </RelativeLayout>
    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/top">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="8dp">
            <TextView android:id="@+id/updateInstalledVersion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" />
            <TextView android:id="@+id/updateStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="13sp"
                android:text="@string/update_gitee_loading" />
            <ProgressBar android:id="@+id/updateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:max="100" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/updateRetry"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/update_gitee_retry" android:textSize="12sp" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/updateDetailsCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginVertical="6dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="8dp">
                    <TextView android:id="@+id/updateVersion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/updateReleaseDetails"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="11sp" />
                    <TextView android:id="@+id/updateNotes"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textIsSelectable="true"
                        android:lineSpacingExtra="2dp" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/updateFileStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="12sp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/updateDownload"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/update_gitee_download" android:textSize="12sp" android:enabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/updateOpenDownloads"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/update_gitee_open_downloads" android:textSize="12sp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/updateOpenGitee"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/update_gitee_open_releases" android:textSize="12sp" />
        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>
</RelativeLayout>
