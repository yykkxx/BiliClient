<?xml version="1.0" encoding="utf-8"?>
<!--
  时间银行（v5.2.0 需求 3）：顶部环形进度 + 中部未来 7 天柱状图 + 底部预支操作区。

  刻意不用 ConstraintLayout + Guideline（历史 lintVitalRelease 的 NotSibling 坑），
  也不引任何第三方图表库：两个图都是本代理的纯自绘 View。
  整页可滚动（RotaryScrollView：本仓库既有的圆屏/手表兼容滚动容器）。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.time.TimeBankActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:lines="1"
            android:text="@string/time_bank_title"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_down" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp" />

    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:id="@+id/time_bank_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingBottom="16dp">

            <!-- ============ 顶部：今天已用 / 可用 环形进度 ============ -->
            <com.RobinNotBad.BiliClient.ui.widget.TimeBankRingView
                android:id="@+id/time_bank_ring"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/time_bank_today_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="13sp"
                android:alpha="0.88"
                tools:text="今天已用 40 分钟 / 可用 120 分钟" />

            <!-- 今日配额用完后额外提示（正常时隐藏） -->
            <TextView
                android:id="@+id/time_bank_exhausted_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/time_bank_exhausted_hint"
                android:textColor="#F44336"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ============ 中部：未来 7 天柱状图 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/time_bank_future_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:text="@string/time_bank_future_desc"
                android:textSize="12sp" />

            <com.RobinNotBad.BiliClient.ui.widget.TimeBankChartView
                android:id="@+id/time_bank_chart"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="6dp" />

            <!-- ============ 底部：预支操作区 ============ -->
            <TextView
                android:id="@+id/time_bank_selected_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="从 11 月 7 日（周六）借" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/time_bank_minus"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/time_bank_minus_10" />

                <TextView
                    android:id="@+id/time_bank_borrow_minutes"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="30 分钟" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/time_bank_plus"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/time_bank_plus_10" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/time_bank_borrow_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/time_bank_borrow_action" />

            <TextView
                android:id="@+id/time_bank_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.8"
                android:gravity="center"
                android:textSize="13sp"
                tools:text="当前预支 30 分钟 / 上限 300 分钟" />

            <TextView
                android:id="@+id/time_bank_rule_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.6"
                android:text="@string/time_bank_rule_hint"
                android:textSize="12sp" />

        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>

</RelativeLayout>
