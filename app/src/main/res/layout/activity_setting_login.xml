<?xml version="1.0" encoding="utf-8"?>
<!-- 「登录选项」页：仿 activity_setting_api_migration.xml 的卡片风格。
     注意：全部使用 LinearLayout / RelativeLayout（不引入 ConstraintLayout），
     从根本上规避 lintVitalRelease 的 NotSibling 类「跨层级约束引用」问题。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.settings.SettingLoginActivity">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="登录选项"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_back" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/activity_padding_horizontal"
            android:paddingVertical="2dp">

            <!-- 实验开关没开时才显示：说明 + 跳实验室引导 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginOptionsLabTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:text="「重构账号体系（实验）」开关还没打开。打开后可以在这里选择一个端口（web / Android手机 / HD / TV）并登录该端口，全接口将统一走该端：该端登录后，web 未登录也能用收藏/历史/动态/消息等全部功能。"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="去实验室开启「重构账号体系」"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/arrow_forward"
                        tools:ignore="RtlCompat" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 状态卡：当前端口 + 四端登录状态 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:id="@+id/loginOptionsStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center_vertical"
                    android:text="当前端口：Web"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 端口选择 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:text="全接口走哪个端口"
                        android:textSize="14sp" />

                    <RadioGroup
                        android:id="@+id/loginOptionsPortGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/loginOptionsPortWeb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Web（软件本身的网页登录，与 5.1.0 一致）"
                            android:textColor="#fff"
                            android:textSize="12sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/loginOptionsPortAndroid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Android手机（与官方手机客户端同协议）"
                            android:textColor="#fff"
                            android:textSize="12sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/loginOptionsPortHd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HD（android_hd）"
                            android:textColor="#fff"
                            android:textSize="12sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/loginOptionsPortTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TV（云视听小电视 android_tv）"
                            android:textColor="#fff"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginBottom="4dp"
                        android:alpha="0.9"
                        android:text="选中即生效（无需重启）。建议先登录所选端口再切换；选 Web 时本功能不改变任何请求行为。"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Web 端口操作行 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginOptionsWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:id="@+id/loginOptionsWebText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center_vertical"
                    android:text="Web 账号"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Android手机 端口操作行 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginOptionsAndroid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:id="@+id/loginOptionsAndroidText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center_vertical"
                    android:text="Android手机端"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <!-- HD 端口操作行 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginOptionsHd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:id="@+id/loginOptionsHdText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center_vertical"
                    android:text="HD端"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <!-- TV 端口操作行 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginOptionsTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:id="@+id/loginOptionsTvText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:lineSpacingExtra="2dp"
                    android:gravity="center_vertical"
                    android:text="TV端"
                    android:textAlignment="textStart"
                    android:textSize="13sp"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 迁移统计卡（与「全 API 迁移状态」页同源） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:id="@+id/loginOptionsStatsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="迁移统计"
                    android:textAlignment="textStart"
                    android:textSize="12sp"
                    tools:ignore="RtlCompat" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 底部说明：实验性质 / 各端独立 / 降级兼容 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/list_margin_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:alpha="0.9"
                    android:text="实验特性说明：\n① 本页面属于实验室实验功能，端口选择只决定全 API 路由走哪个端口；推荐页移动端逻辑的身份仍由其自身设置控制。\n② 四个端口的登录互相独立：Web 用软件本身的 Cookie，Android手机/HD/TV 各自用独立 token，可同时登录、互不影响，登录信息不跨端转移。\n③ 降级回老版本后，新开关与新端口选择会被当作不存在，本功能自动失效；web 与三端的既有登录均不受影响。"
                    android:textSize="11sp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.RobinNotBad.BiliClient.ui.widget.RotaryScrollView>
</RelativeLayout>
